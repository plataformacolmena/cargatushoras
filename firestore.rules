rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function requester() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApproved() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        requester().data.approvalStatus == 'APPROVED';
    }

    function isAdminRole() {
      return isApproved() && requester().data.role in ['SUPERUSER', 'PROJECT_ADMIN'];
    }

    function isSuperUser() {
      return isApproved() && requester().data.role == 'SUPERUSER';
    }

    match /users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdminRole() ||
        // Permite a un usuario autenticado leer sólo placeholders cuyo email
        // coincida con el suyo. Necesario para que un usuario recién registrado
        // encuentre y reclame su propio placeholder, sin permitir enumerar
        // todos los placeholders del sistema.
        (isSignedIn() &&
          resource.data.isPlaceholder == true &&
          request.auth.token.email != null &&
          resource.data.email == request.auth.token.email.lower());
      allow create: if (isSignedIn() && request.auth.uid == uid) || isAdminRole();
      allow update: if (
        isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.get('cycleMode', 'CYCLE') == resource.data.get('cycleMode', 'CYCLE')
      ) || (
        isAdminRole() &&
        // Defensa en profundidad: si se cambia el rol, debe ser un valor válido.
        request.resource.data.role in ['SUPERUSER', 'PROJECT_ADMIN', 'MEMBER']
      ) || (
        // Cualquier usuario autenticado puede marcar como fusionado un placeholder cuyo email coincida con el suyo.
        // (No requiere estar APPROVED — el placeholder PENDING también se puede reclamar al primer login.)
        isSignedIn() &&
        resource.data.isPlaceholder == true &&
        resource.data.get('mergedToUid', null) == null &&
        request.auth.token.email != null &&
        resource.data.email == request.auth.token.email.lower() &&
        request.resource.data.mergedToUid == request.auth.uid &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email
      );
      allow delete: if (
        // SUPERUSER puede borrar cualquier doc de /users (incluyendo placeholders,
        // duplicados y otros SUPERUSER) excepto el propio. Necesario para
        // limpiar duplicados/conflictos por email vía Plan D (deep delete).
        isSuperUser() && request.auth.uid != uid
      ) || (
        isAdminRole() && (
          resource.data.isPlaceholder == true ||
          (
            resource.data.role != 'SUPERUSER' &&
            request.auth.uid != uid
          )
        )
      );
    }

    match /projects/{projectId} {
      allow read: if isApproved();
      allow create, update: if isSuperUser();
      allow delete: if false;
    }

    match /project_configs/{projectId} {
      allow read: if isApproved();
      allow create, update: if isAdminRole();
      allow delete: if false;
    }

    match /project_areas/{areaId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdminRole();
    }

    match /project_roles/{roleId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdminRole();
    }

    match /project_templates/{templateId} {
      allow read: if isApproved();
      allow create, update: if isAdminRole();
      allow delete: if isSuperUser();
    }

    // Configuración global de la app (modo mantenimiento, banners, etc.)
    // Lectura abierta a cualquier usuario autenticado (incluso PENDING) para que
    // todos puedan recibir la señal de mantenimiento. Escritura solo SUPERUSER.
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSuperUser();
      allow delete: if false;
    }

    match /time_entries/{entryId} {
      allow read: if isApproved();

      allow create: if (isApproved() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.calculationSource == 'client' &&
        request.resource.data.calculationVersion == 'v1-client' &&
        request.resource.data.lockedByAdmin == false) ||
        (isAdminRole() &&
        request.resource.data.calculationSource == 'client' &&
        request.resource.data.calculationVersion == 'v1-client');

      allow update: if (
        // Bloqueo total: las jornadas archivadas son inmutables (excepto para SUPERUSER).
        resource.data.get('archived', false) == false || isSuperUser()
      ) && ((isAdminRole() && (
        // Defensa en profundidad: si se cambia el color de revisión, debe estar en el set permitido.
        !('reviewColor' in request.resource.data) ||
        request.resource.data.reviewColor in ['', 'green', 'yellow', 'red', 'orange', 'blue']
      )) || (
        isApproved() &&
        resource.data.userId == request.auth.uid &&
        resource.data.lockedByAdmin == false &&
        resource.data.get('lockedByAudit', false) == false &&
        request.resource.data.calculationSource == resource.data.calculationSource &&
        request.resource.data.calculationVersion == resource.data.calculationVersion
      ) || (
        // Migración de placeholder: reasignar entradas al UID real del usuario
        isApproved() &&
        resource.data.lockedByAdmin == false &&
        request.resource.data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.isPlaceholder == true
      ));

      allow delete: if isSuperUser() || ((
        // Las jornadas archivadas sólo las puede borrar SUPERUSER (cubierto arriba).
        resource.data.get('archived', false) == false
      ) && (isAdminRole() || (
        isApproved() &&
        resource.data.userId == request.auth.uid &&
        resource.data.lockedByAdmin == false &&
        resource.data.get('lockedByAudit', false) == false
      )));
    }

    // ─── Bloqueo de ediciones por auditoría ──────────────────────────────
    match /audit_locks/{projectId} {
      allow read: if isApproved();
      allow create, update: if isAdminRole();
      allow delete: if isSuperUser();
    }

    // ─── Ciclos laborales por usuario ─────────────────────────────────────
    // user_work_cycles/{cycleId}: { userId, projectId, anchorDate, closedFromDate?, closedAt?, closedBy?, createdBy, createdAt, updatedAt? }
    match /user_work_cycles/{cycleId} {
      // Read: el propio dueño del ciclo, o cualquier admin/super del sistema.
      allow read: if isAdminRole() || (isApproved() && resource.data.userId == request.auth.uid);

      // Create: el propio usuario (modo CYCLE, no REINFORCEMENT) o un admin.
      //   - userId del nuevo ciclo debe coincidir con request.auth.uid (o ser admin).
      //   - anchorDate es string YYYY-MM-DD básico.
      //   - createdBy debe ser request.auth.uid.
      //   - No puede estar pre-cerrado.
      allow create: if (
        isAdminRole() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.anchorDate is string &&
        !('closedFromDate' in request.resource.data)
      ) || (
        isApproved() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.anchorDate is string &&
        !('closedFromDate' in request.resource.data) &&
        // El usuario debe estar en modo CYCLE (default si no está seteado).
        requester().data.get('cycleMode', 'CYCLE') == 'CYCLE'
      );

      // Update / close / reopen / edit anchor: solo admins.
      allow update: if isAdminRole();

      // Delete: solo SUPERUSER.
      allow delete: if isSuperUser();
    }

    match /settlements/{settlementId} {
      allow read: if isApproved();
      allow create: if isAdminRole();
      // Admins pueden actualizar una liquidación no archivada (para archivarla).
      // Una vez archivada (archivedAt presente), sólo SUPERUSER puede modificar.
      allow update: if isSuperUser() || (
        isAdminRole() && resource.data.get('archivedAt', null) == null
      );
      allow delete: if isSuperUser();
    }

    // ─── Chat / Soporte ────────────────────────────────────────────────────
    match /chat_threads/{threadId} {
      // Helper: ¿el usuario actual puede ver el hilo?
      function canView() {
        return isApproved() && (
          isSuperUser() ||
          // PROJECT_ADMIN del proyecto
          (requester().data.role == 'PROJECT_ADMIN' &&
            requester().data.projectId == resource.data.projectId) ||
          // MEMBER: depende del scope
          (requester().data.projectId == resource.data.projectId && (
            resource.data.scope == 'PUBLIC' ||
            (resource.data.scope == 'AREA' &&
              requester().data.areaId == resource.data.areaId) ||
            (resource.data.scope == 'PRIVATE' &&
              resource.data.createdBy == request.auth.uid)
          ))
        );
      }

      allow read: if canView();

      // Crear hilo: usuario aprobado, proyecto coincide, campos válidos
      allow create: if isApproved() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.projectId == requester().data.projectId &&
        request.resource.data.scope in ['PRIVATE', 'AREA', 'PUBLIC'] &&
        request.resource.data.title is string &&
        (request.resource.data.scope != 'AREA' ||
          (request.resource.data.areaId is string &&
            request.resource.data.areaId == requester().data.areaId));

      // Update: refrescar resumen del último mensaje (cualquier participante con acceso)
      // o cambiar status (solo superuser / admin del proyecto)
      allow update: if canView() &&
        request.resource.data.projectId == resource.data.projectId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.createdBy == resource.data.createdBy && (
          // Caso 1: status no cambia (refresco normal de lastMessage)
          (request.resource.data.get('status', 'OPEN') == resource.data.get('status', 'OPEN')) ||
          // Caso 2: cambia status → solo superuser o admin del proyecto
          isSuperUser() ||
          (requester().data.role == 'PROJECT_ADMIN' &&
            requester().data.projectId == resource.data.projectId)
        );

      // Borrar: admin del proyecto, superuser, o el creador
      allow delete: if isSuperUser() ||
        (requester().data.role == 'PROJECT_ADMIN' &&
          requester().data.projectId == resource.data.projectId) ||
        (isApproved() && resource.data.createdBy == request.auth.uid);

      match /messages/{messageId} {
        function parentThread() {
          return get(/databases/$(database)/documents/chat_threads/$(threadId)).data;
        }
        function canViewParent() {
          return isApproved() && (
            isSuperUser() ||
            (requester().data.role == 'PROJECT_ADMIN' &&
              requester().data.projectId == parentThread().projectId) ||
            (requester().data.projectId == parentThread().projectId && (
              parentThread().scope == 'PUBLIC' ||
              (parentThread().scope == 'AREA' &&
                requester().data.areaId == parentThread().areaId) ||
              (parentThread().scope == 'PRIVATE' &&
                parentThread().createdBy == request.auth.uid)
            ))
          );
        }

        allow read: if canViewParent();
        allow create: if canViewParent() &&
          parentThread().get('status', 'OPEN') == 'OPEN' &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          // No permitir mensajes que sean sólo espacios en blanco.
          request.resource.data.text.matches('[\\s\\S]*\\S[\\s\\S]*');
        allow update: if false;
        allow delete: if isSuperUser() ||
          (requester().data.role == 'PROJECT_ADMIN' &&
            requester().data.projectId == parentThread().projectId) ||
          (isApproved() && resource.data.senderUid == request.auth.uid);
      }
    }

    // ─── Recordatorios de jornada ────────────────────────────────────────
    // Estructura: /reminders/{projectId}/items/{reminderId}
    // El admin crea recordatorios para que un usuario informe una jornada
    // pendiente; el banner del usuario los muestra hasta que él (o el admin)
    // carga la jornada de esa fecha, momento en el cual el cliente borra el
    // documento.
    match /reminders/{projectId}/items/{reminderId} {
      // Read: cualquier usuario aprobado. El doc solo contiene { projectId,
      // userId, workDate, createdBy, createdAt } — no hay información
      // sensible. El admin lee todos para mostrar el estado del botón
      // "Recordar/Recordado"; el usuario destinatario filtra por su propio
      // userId para mostrar su banner.
      allow read: if isApproved();

      // Create: solo admins. Campos validados.
      allow create: if isAdminRole() &&
        request.resource.data.projectId == projectId &&
        request.resource.data.userId is string &&
        request.resource.data.workDate is string &&
        request.resource.data.createdBy == request.auth.uid;

      // Update: no se permiten ediciones (el flujo solo crea o borra).
      allow update: if false;

      // Delete: admin (cuando carga la jornada por el usuario o lo quiere
      // limpiar manualmente) o el propio usuario (al cargar su jornada).
      allow delete: if isAdminRole() ||
        (isApproved() && resource.data.userId == request.auth.uid);
    }

    // ─── Tickets de soporte ──────────────────────────────────────────────
    // Estructura: /support_tickets/{projectId}/items/{ticketId}
    // Reemplaza al chat de soporte: el usuario envía un ticket (1 escritura)
    // y los admins lo listan bajo demanda. Sin listeners permanentes.
    match /support_tickets/{projectId}/items/{ticketId} {
      // Read: solo admins del proyecto correspondiente (o SUPERUSER).
      // Members NO listan tickets (UX: el usuario solo envía y recibe
      // respuesta por email/whatsapp del admin).
      allow read: if isSuperUser() ||
        (isApproved() &&
          requester().data.role == 'PROJECT_ADMIN' &&
          requester().data.projectId == projectId);

      // Create: cualquier usuario aprobado puede crear su propio ticket.
      allow create: if isApproved() &&
        request.resource.data.projectId == projectId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() > 0 &&
        request.resource.data.subject.size() <= 200 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 4000 &&
        request.resource.data.status == 'open';

      // Update: solo admins del proyecto (cerrar/reabrir).
      allow update: if isSuperUser() ||
        (isApproved() &&
          requester().data.role == 'PROJECT_ADMIN' &&
          requester().data.projectId == projectId);

      // Delete: solo SUPERUSER.
      allow delete: if isSuperUser();
    }
  }
}
